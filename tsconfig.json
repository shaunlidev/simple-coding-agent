{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@simple-coding-agent/ai": ["packages/ai/src/index.ts"],
      "@simple-coding-agent/agent": ["packages/agent/src/index.ts"],
      "@simple-coding-agent/coding-agent": ["packages/coding-agent/src/index.ts"],
      "@simple-coding-agent/db": ["packages/db/src/index.ts"],
      "@simple-coding-agent/runtime": ["packages/runtime/src/index.ts"],
      "@simple-coding-agent/security": ["packages/security/src/index.ts"]
    },
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "evals/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts"]
}
