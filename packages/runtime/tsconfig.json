{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "baseUrl": "../..",
    "paths": {
      "@simple-coding-agent/ai": ["packages/ai/src/index.ts"],
      "@simple-coding-agent/agent": ["packages/agent/src/index.ts"],
      "@simple-coding-agent/db": ["packages/db/src/index.ts"],
      "@simple-coding-agent/security": ["packages/security/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../types/**/*.d.ts"],
  "references": [{ "path": "../db" }, { "path": "../security" }, { "path": "../ai" }, { "path": "../agent" }]
}
